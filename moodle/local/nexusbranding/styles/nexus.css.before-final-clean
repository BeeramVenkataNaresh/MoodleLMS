:root {
    --nexus-blue: #1a73e8;
    --nexus-blue-dark: #1557b0;
    --nexus-blue-soft: #e8f0fe;
    --nexus-sky: #eaf4ff;
    --nexus-text: #172033;
    --nexus-muted: #667085;
    --nexus-border: rgba(31, 59, 94, 0.08);
}


/* =====================================================
   GLOBAL
   ===================================================== */

html {
    background: #f7faff;
}

body {
    color:
        var(--nexus-text);
}


/* =====================================================
   NAVBAR
   ===================================================== */

.navbar,
.navbar.fixed-top {
    background:
        rgba(255, 255, 255, 0.94) !important;

    border-bottom:
        1px solid rgba(23, 48, 78, 0.06);

    box-shadow:
        0 3px 18px rgba(32, 58, 90, 0.045);

    backdrop-filter:
        blur(16px) saturate(145%);

    -webkit-backdrop-filter:
        blur(16px) saturate(145%);
}


.nexus-navbar-brand {
    display: inline-flex;

    align-items: center;

    margin-right: 24px;
}


.nexus-navbar-brand img {
    display: block;

    width: auto;

    height: 34px;

    object-fit: contain;
}


/* =====================================================
   LANDING PAGE
   ===================================================== */

body.nexus-landing-page {
    background:
        radial-gradient(
            circle at 5% 0%,
            rgba(26, 115, 232, 0.16),
            transparent 30%
        ),
        radial-gradient(
            circle at 92% 18%,
            rgba(79, 195, 247, 0.15),
            transparent 32%
        ),
        radial-gradient(
            circle at 70% 90%,
            rgba(105, 160, 255, 0.10),
            transparent 36%
        ),
        linear-gradient(
            180deg,
            #f9fcff 0%,
            #eef6ff 48%,
            #f7faff 100%
        ) !important;
}


body.nexus-landing-page
#page,

body.nexus-landing-page
#page-wrapper,

body.nexus-landing-page
#page-content,

body.nexus-landing-page
#region-main {
    background:
        transparent !important;
}


/* Remove demo blocks while keeping them in DOM */

.nexus-hide-demo {
    display:
        none !important;
}


/* =====================================================
   LANDING HERO
   ===================================================== */

.nexus-home-hero {
    position: relative;

    width:
        min(
            calc(100% - 24px),
            1280px
        );

    aspect-ratio:
        1672 / 941;

    margin:
        18px auto 34px;

    overflow: hidden;

    border:
        1px solid rgba(255, 255, 255, 0.82);

    border-radius:
        20px;

    background:
        #eaf2fb;

    box-shadow:
        0 24px 60px rgba(28, 72, 121, 0.13),
        0 5px 16px rgba(28, 72, 121, 0.055);
}


.nexus-home-hero__image {
    position: absolute;

    inset: 0;

    display: block;

    width: 100%;

    height: 100%;

    object-fit: cover;

    opacity: 0;

    transform: none !important;

    transition:
        opacity 650ms ease;
}


.nexus-home-hero__image.is-active {
    opacity: 1;
}


/*
 * Ensure no old overlays survive.
 */

.nexus-home-hero::before,
.nexus-home-hero::after,
.nexus-home-hero__content,
.nexus-home-hero__glass {
    display: none !important;
}


/* Slider dots */

.nexus-home-hero__dots {
    position: absolute;

    z-index: 10;

    left: 50%;

    bottom: 14px;

    display: flex;

    align-items: center;

    gap: 6px;

    transform:
        translateX(-50%);
}


.nexus-home-hero__dot {
    width: 7px;

    height: 7px;

    min-width: 0;

    padding: 0;

    appearance: none;

    border: 0;

    border-radius: 999px;

    background:
        rgba(255, 255, 255, 0.70);

    box-shadow:
        0 1px 4px rgba(0, 0, 0, 0.10);

    transition:
        width 180ms ease,
        opacity 180ms ease;
}


.nexus-home-hero__dot.is-active {
    width: 20px;

    background:
        #ffffff;
}


/* =====================================================
   GENERAL MOODLE CARDS
   ===================================================== */

body:not(.nexus-login-page)
.card,

body:not(.nexus-login-page)
.block,

body:not(.nexus-login-page)
.dashboard-card {
    border:
        1px solid rgba(29, 52, 79, 0.06) !important;

    border-radius:
        14px !important;

    box-shadow:
        0 7px 24px rgba(31, 55, 88, 0.055) !important;
}


/* =====================================================
   BUTTONS
   ===================================================== */

.btn {
    border-radius:
        9px !important;
}


.btn-primary {
    background:
        var(--nexus-blue) !important;

    border-color:
        var(--nexus-blue) !important;

    box-shadow:
        0 5px 14px rgba(26, 115, 232, 0.16) !important;
}


.btn-primary:hover {
    background:
        var(--nexus-blue-dark) !important;

    border-color:
        var(--nexus-blue-dark) !important;
}


/* =====================================================
   PREMIUM LANDING FOOTER
   ===================================================== */

body.nexus-landing-page
#page-footer {
    margin: 0 !important;

    padding: 0 !important;

    background:
        transparent !important;
}


/*
 * Hide Moove's existing footer.
 */

body.nexus-landing-page
#page-footer > *:not(.nexus-footer) {
    display: none !important;
}


.nexus-footer {
    position: relative;

    overflow: hidden;

    margin-top:
        48px;

    padding:
        54px 32px 26px;

    color:
        rgba(255, 255, 255, 0.80);

    background:
        linear-gradient(
            135deg,
            #0b2f6b 0%,
            #0d47a1 48%,
            #1264c7 100%
        );

    box-shadow:
        0 -12px 42px
        rgba(24, 68, 118, 0.10);
}


.nexus-footer::before {
    content: "";

    position: absolute;

    width: 560px;

    height: 560px;

    right: -180px;

    top: -320px;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.055);
}


.nexus-footer::after {
    content: "";

    position: absolute;

    width: 380px;

    height: 380px;

    left: -120px;

    bottom: -270px;

    border-radius: 50%;

    background:
        rgba(80, 180, 255, 0.09);
}


.nexus-footer__inner {
    position: relative;

    z-index: 2;

    width:
        min(1200px, 100%);

    margin:
        0 auto;
}


.nexus-footer__top {
    display: grid;

    grid-template-columns:
        minmax(0, 1.4fr)
        minmax(340px, 0.8fr);

    gap:
        70px;

    align-items: start;
}


.nexus-footer__brand {
    max-width:
        500px;
}


.nexus-footer__logo {
    display: block;

    width: 175px;

    height: auto;

    margin-bottom:
        20px;

    /*
     * Logo has dark writing,
     * so give it a tiny white pill.
     */
    padding:
        10px 14px;

    border-radius:
        12px;

    background:
        rgba(255, 255, 255, 0.96);

    box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.10);
}


.nexus-footer__brand p {
    margin: 0;

    max-width:
        460px;

    color:
        rgba(255, 255, 255, 0.74);

    line-height:
        1.7;

    font-size:
        0.94rem;
}


.nexus-footer__links {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap:
        40px;
}


.nexus-footer__links > div {
    display: flex;

    flex-direction: column;

    gap:
        10px;
}


.nexus-footer__label {
    margin-bottom:
        3px;

    color:
        #ffffff;

    font-size:
        0.84rem;

    font-weight:
        700;

    letter-spacing:
        0.035em;

    text-transform:
        uppercase;
}


.nexus-footer__links a {
    color:
        rgba(255, 255, 255, 0.72);

    text-decoration:
        none;

    transition:
        color 150ms ease;
}


.nexus-footer__links a:hover {
    color:
        #ffffff;
}


.nexus-footer__bottom {
    display: flex;

    justify-content:
        space-between;

    align-items:
        center;

    gap:
        20px;

    margin-top:
        42px;

    padding-top:
        21px;

    border-top:
        1px solid rgba(255, 255, 255, 0.13);

    color:
        rgba(255, 255, 255, 0.56);

    font-size:
        0.82rem;
}


