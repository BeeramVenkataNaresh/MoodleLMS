/* Login button */

body#page-login-index
.btn-primary {
    min-height:
        48px;

    border:
        0 !important;

    border-radius:
        11px !important;

    background:
        linear-gradient(
            135deg,
            #1f66ce,
            #124a9d
        ) !important;

    color:
        #ffffff !important;

    font-weight:
        600;

    box-shadow:
        0 8px 22px rgba(21, 84, 184, 0.20) !important;

    transition:
        transform 160ms ease,
        box-shadow 160ms ease;
}


body#page-login-index
.btn-primary:hover {
    transform:
        translateY(-1px);

    box-shadow:
        0 12px 28px rgba(21, 84, 184, 0.24) !important;
}


/*
 * Login footer should be tiny/minimal.
 */

body#page-login-index
#page-footer {
    display:
        none !important;
}


/* Remove Moove login decorations/background media */

body#page-login-index
.login-bg,
body#page-login-index
.login-background,
body#page-login-index
[class*="login-background"],
body#page-login-index
[class*="login-bg"] {
    display:
        none !important;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 767.98px) {

    body.pagelayout-frontpage
    .nexus-home-hero {
        width:
            calc(100% - 20px);

        margin:
            18px auto 38px;

        border-radius:
            17px;
    }


    .nexus-footer {
        margin-top:
            42px;

        padding:
            34px 20px 24px;
    }


    body#page-login-index
    #page-wrapper {
        padding:
            22px 14px !important;
    }


    body#page-login-index
    .login-container {
        width:
            min(100%, 430px);

        padding:
            30px 24px 26px !important;

        border-radius:
            18px !important;
    }


    .nexus-login-brand img {
        width:
            145px;
    }

}


/* =====================================================
   END NEXUS PREMIUM LOGIN + LANDING FINAL
   ===================================================== */

