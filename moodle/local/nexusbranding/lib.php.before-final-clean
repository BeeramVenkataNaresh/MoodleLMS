<?php

defined('MOODLE_INTERNAL') || die();

/**
 * Nexus branding assets.
 *
 * CSS is requested from the HTML head so the original
 * Moove homepage never flashes before Nexus JS starts.
 */
function local_nexusbranding_before_standard_html_head() {
    global $PAGE;

    $PAGE->requires->css(
        '/local/nexusbranding/styles/nexus.css'
    );

    $PAGE->requires->js(
        '/local/nexusbranding/js/nexus.js',
        true
    );

    return '
<style id="nexus-critical-css">

/*
 * CRITICAL FIRST-PAINT PROTECTION
 *
 * Moodle adds pagelayout-frontpage server-side,
 * therefore this executes before our JavaScript.
 */

body.pagelayout-frontpage #region-main {
    position: relative !important;
    min-height: 540px;
    overflow: hidden;
}

/*
 * Hide ALL original Moove homepage children immediately.
 *
 * Do not remove them from the DOM because Moove JavaScript
 * may still expect them.
 */
body.pagelayout-frontpage
#region-main > * {
    display: none !important;
}

/*
 * Our Nexus hero is the only permitted front-page child.
 */
body.pagelayout-frontpage
#region-main > .nexus-home-hero {
    display: block !important;
}

/*
 * Prevent incomplete hero rendering.
 */
body.pagelayout-frontpage
.nexus-home-hero {
    opacity: 0;
}

body.pagelayout-frontpage.nexus-hero-ready
.nexus-home-hero {
    opacity: 1;
}

</style>
';
}
