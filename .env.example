# Copy this file to .env, then run ./scripts/generate-secrets.sh before starting.
COMPOSE_PROJECT_NAME=nexus-eps-lms

# Local URLs and Nexus configuration
MOODLE_URL=http://localhost:8080
MOODLE_SITE_FULLNAME=Nexus Education Private School
MOODLE_SITE_SHORTNAME=Nexus EPS
MOODLE_PORTAL_NAME=Nexus Learning Management System
MOODLE_PRODUCTION_URL=https://lms.nexuseps.com
MOODLE_PUBLIC_WEBSITE=https://nexuseps.com
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_EMAIL=mspixelpulse@gmail.com

# Generate unique values locally. Never commit a populated .env file.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-64-character-secret
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=replace-with-a-unique-64-character-secret
REDIS_PASSWORD=replace-with-a-unique-64-character-secret
MOODLE_ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Internal service settings
REDIS_HOST=redis
REDIS_PORT=6379
MOODLE_SMTP_HOST=mailpit
MOODLE_SMTP_PORT=1025
